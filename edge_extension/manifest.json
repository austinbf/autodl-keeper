{
  "manifest_version": 3,
  "name": "AutoDL 续航",
  "version": "1.2.3",
  "description": "查询 AutoDL 实例并逐台执行无卡开关机。",
  "key": "",
  "action": {
    "default_title": "AutoDL 续航",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
